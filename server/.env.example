# Copy to .env and fill in. The server validates all of this at startup and
# refuses to boot with a clear message if anything is missing or malformed,
# so a bad config fails immediately rather than on someone's first login.

# development | test | production
NODE_ENV=development
PORT=5000

DATABASE_URL=postgres://user:password@localhost:5432/discord_clone

# Must be at least 32 characters, and the two must differ from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Where the frontend lives. Password reset links are built from this.
APP_URL=http://localhost:5173

# Email. With EMAIL_DEV_LOG=true, reset links are printed to the console and
# RESEND_API_KEY is not needed. Set it to false to send real email.
EMAIL_DEV_LOG=true
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# How many proxies (nginx, Render, Fly, Cloudflare...) sit in front of the app.
# 0 = none. MUST match your deployment: too low and every client shares the
# proxy's IP, so one rate-limit budget covers the whole internet; too high and a
# caller can forge X-Forwarded-For to hand themselves a fresh budget.
TRUST_PROXY=0

# Comma-separated browser origins allowed to call this API. Required in
# production. Left empty in development, any origin is echoed back.
CORS_ORIGINS=http://localhost:5173

# silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Optional: tests run in an isolated schema inside DATABASE_URL. Set this only
# if you want them pointed at a different server entirely.
# TEST_DATABASE_URL=
